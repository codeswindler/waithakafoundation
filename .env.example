# Copy to .env and fill in. Never commit .env.

# --- Database (MySQL 8 or MariaDB 10.6+) ---
DATABASE_URL=mysql://waithaka:CHANGE_ME@127.0.0.1:3306/waithaka
# or: DB_HOST=127.0.0.1  DB_PORT=3306  DB_USER=waithaka  DB_PASSWORD=...  DB_NAME=waithaka

# --- Local development only (docker compose up -d starts MySQL on port 3418) ---
# MYSQL_ROOT_PASSWORD=choose-one
# MYSQL_PASSWORD=choose-one
# DATABASE_URL=mysql://waithaka:<MYSQL_PASSWORD>@127.0.0.1:3418/waithaka
# TEST_DATABASE_URL=mysql://waithaka:<MYSQL_PASSWORD>@127.0.0.1:3418/waithaka_test
# PORT=3100
# BASE_URL=http://localhost:3100

# --- Production (PM2 ecosystem.config.js already sets PORT, BASE_URL, NODE_ENV, COOKIE_SECURE) ---
# SESSION_SECRET=long-random-string
# ADMIN_EMAIL=admin@waithakafoundation.org
# ADMIN_PASSWORD=only-used-when-no-admin-exists-yet
# MAX_VIDEO_MB=300

# --- Optional email alerts for website enquiries ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=website@waithakafoundation.org
# SMTP_PASS=...
# SMTP_FROM="Waithaka Foundation <website@waithakafoundation.org>"
