<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<link rel="apple-touch-icon" href="/static/img/icon-180.png">
<meta name="robots" content="noindex">
<title><%= title %> · Admin · <%= s.site_name %></title>
<link rel="icon" href="/static/img/favicon-64.png" type="image/png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/static/css/admin.css">
</head>
<body>
<% const items = [
  ['/admin', 'Dashboard', 'home'], ['/admin/events', 'Events', 'calendar'], ['/admin/media', 'Photos & videos', 'camera'],
  ['/admin/milestones', 'Achievements', 'star'], ['/admin/partners', 'Partners & sponsors', 'handshake'], ['/admin/team', 'Board & team', 'users'],
  ['/admin/settings', 'Website content', 'file'], ['/admin/messages', 'Messages', 'mail'], ['/admin/account', 'Account & admins', 'shield']];
  const here = path.replace(/\/$/, ''); %>
<div class="shell">
  <aside class="side" id="side">
    <a class="side-brand" href="/admin"><img src="/static/img/waithaka-logo-badge.png" alt="" width="38" height="38"><span><b><%= s.site_name %></b><small>Admin</small></span></a>
    <nav>
      <% items.forEach(([href, label, ic]) => { const on = href === '/admin' ? here === '/admin' : here.startsWith(href); %>
      <a href="<%= href %>" class="<%= on ? 'on' : '' %>"><%- icon(ic) %><span><%= label %></span><% if (href === '/admin/messages' && unread) { %><em><%= unread %></em><% } %></a>
      <% }) %>
    </nav>
    <div class="side-foot">
      <a href="/" target="_blank" class="view-site"><%- icon('arrow') %> View live website</a>
      <form method="post" action="/admin/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button type="submit">Sign out <%= user.name ? '(' + user.name + ')' : '' %></button></form>
    </div>
  </aside>
  <div class="main">
    <header class="top">
      <button class="side-toggle" aria-label="Menu" aria-controls="side"><span></span><span></span><span></span></button>
      <h1><%= title %></h1>
      <div class="top-actions"><%- locals.actions || '' %></div>
    </header>
    <div class="content">
      <% if (flash) { %><div class="flash <%= flash.type %>" role="status"><%= flash.text %></div><% } %>
