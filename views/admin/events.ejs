<%- include('_head', { actions: '<a class="btn primary" href="/admin/events/new">+ New event</a>' }) %>
<% function table(list, emptyText) { %>
  <% if (!list.length) { %><p class="muted"><%= emptyText %></p><% } else { %>
  <div class="table-wrap"><table class="table">
    <thead><tr><th></th><th>Event</th><th>Date</th><th>Media</th><th>Status</th><th></th></tr></thead>
    <tbody>
    <% list.forEach((e) => { %>
      <tr>
        <td class="thumbcell"><% if (e.cover_thumb) { %><img src="/uploads/<%= e.cover_thumb %>" alt=""><% } else { %><span class="noimg"><%- icon('calendar') %></span><% } %></td>
        <td><a href="/admin/events/<%= e.id %>"><b><%= e.title %></b></a><small class="muted block"><%= e.venue || 'No venue set' %></small></td>
        <td class="nowrap"><%= e.date_tbc ? h.MONTHS[+e.start_date.slice(5,7)-1] + ' ' + e.start_date.slice(0,4) : h.fmtDate(e.start_date) %><small class="muted block"><%= e.date_tbc ? 'Date to be confirmed' : h.timeRange(e.start_time, e.end_time) %></small></td>
        <td><%= e.media_count %></td>
        <td>
          <% if (!e.published) { %><span class="pill">Hidden</span><% } else { %><span class="pill ok">Live</span><% } %>
          <% if (e.featured) { %><span class="pill gold">Featured</span><% } %>
          <% if (e.sample) { %><span class="pill warn" title="Added at setup: open it, check the details and save.">Check details</span><% } %>
        </td>
        <td class="nowrap right"><a class="btn sm" href="/admin/events/<%= e.id %>">Edit</a> <% if (e.published) { %><a class="btn sm ghost" href="/events/<%= e.slug %>" target="_blank">View</a><% } %></td>
      </tr>
    <% }) %>
    </tbody>
  </table></div>
  <% } %>
<% } %>
<section class="card">
  <div class="card-head"><h2>Upcoming (<%= upcoming.length %>)</h2></div>
  <% table(upcoming, 'No upcoming events yet.') %>
</section>
<section class="card" id="past">
  <div class="card-head"><h2>Past events (<%= past.length %>)</h2></div>
  <p class="muted small">Past events become your track record. Add photos, videos, attendance and what was achieved to each one.</p>
  <% table(past, 'No past events yet. Add reports of gatherings you have already held. Choose a past date and they will show as past events.') %>
</section>
<%- include('_foot') %>
