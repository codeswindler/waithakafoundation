<div class="gv-cards swipe">
  <% giving.forEach((g, i) => { const m = g.photos[0]; %>
  <a class="gv-card reveal d<%= i % 3 %>" href="/giving#<%= g.key %>">
    <img src="/uploads/<%= m.file %>" srcset="<%= h.srcset(m.file) %>" sizes="(max-width: 760px) 84vw, 280px" alt="<%= m.title || g.title %>" loading="lazy">
    <span class="gv-text"><b><%= g.title %></b><span><%= g.short %></span></span>
  </a>
  <% }) %>
</div>
