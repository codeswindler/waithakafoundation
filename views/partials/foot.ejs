</main>
<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <a class="brand" href="/"><img src="/static/img/logo-mark.svg" alt="" width="46" height="46"><span><span class="brand-name"><%= s.site_name %></span><span class="brand-sub">For the Elderly · Limuru</span></span></a>
        <p style="margin-top:18px"><%= s.vision %></p>
        <% const soc = [['facebook','facebook'],['instagram','instagram'],['youtube','youtube'],['x','xsocial'],['tiktok','tiktok']].filter(([k]) => s[k]); %>
        <% if (soc.length || s.whatsapp) { %><div class="socials">
          <% soc.forEach(([k, ic]) => { %><a href="<%= h.safeUrl(s[k]) %>" target="_blank" rel="noopener" aria-label="<%= k %>"><%- icon(ic) %></a><% }) %>
          <% if (s.whatsapp) { %><a href="https://wa.me/<%= h.waNumber(s.whatsapp) %>" target="_blank" rel="noopener" aria-label="WhatsApp"><%- icon('whatsapp') %></a><% } %>
        </div><% } %>
      </div>
      <div>
        <h4>Explore</h4>
        <ul><li><a href="/about">About the foundation</a></li><li><a href="/programmes">Our programmes</a></li><li><a href="/events">Events</a></li><li><a href="/gallery">Photos &amp; videos</a></li><li><a href="/impact">Our impact</a></li></ul>
      </div>
      <div>
        <h4>Get involved</h4>
        <ul><li><a href="/support#give">Give</a></li><li><a href="/support#campaign">Land campaign</a></li><li><a href="/support#form">Partner with us</a></li><li><a href="/support#form">Volunteer</a></li><% if (s.brief_pdf === '1') { %><li><a href="/brief.pdf" target="_blank">Foundation brief (PDF)</a></li><% } %></ul>
      </div>
      <div>
        <h4>Reach us</h4>
        <ul>
          <li><%= s.address %></li>
          <% if (s.phone) { %><li><a href="tel:<%= s.phone.replace(/\s/g,'') %>"><%= s.phone %></a></li><% } %>
          <% if (s.email) { %><li><a href="mailto:<%= s.email %>"><%= s.email %></a></li><% } %>
          <li><a href="/contact">Send us a message →</a></li>
        </ul>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© <%= year %> <%= s.site_full_name %>. A registered Community Based Organization, Kiambu County, Kenya.</span>
      <span><a href="#top">Back to top ↑</a></span>
    </div>
  </div>
</footer>
<% const quick = s.whatsapp ? { href: 'https://wa.me/' + h.waNumber(s.whatsapp), label: 'WhatsApp', ic: 'whatsapp', ext: true } : s.phone ? { href: 'tel:' + s.phone.replace(/\s/g, ''), label: 'Call us', ic: 'phone' } : { href: '/contact', label: 'Contact', ic: 'mail' }; %>
<nav class="mbar" aria-label="Quick actions">
  <a href="/events"<%- path.startsWith('/events') ? ' aria-current="page"' : '' %>><%- icon('calendar') %><span>Events</span></a>
  <a class="mbar-give" href="/support"><%- icon('heart') %><span>Give</span></a>
  <a href="<%= quick.href %>"<%- quick.ext ? ' target="_blank" rel="noopener"' : '' %>><%- icon(quick.ic) %><span><%= quick.label %></span></a>
</nav>
<div class="lb" id="lightbox" role="dialog" aria-modal="true" aria-label="Media viewer" hidden>
  <span class="lb-count"></span>
  <div class="lb-stage"></div>
  <button class="lb-close" aria-label="Close"><%- icon('x') %></button>
  <button class="lb-prev" aria-label="Previous"><%- icon('left') %></button>
  <button class="lb-next" aria-label="Next"><%- icon('right') %></button>
</div>
<script src="/static/js/site.js" defer></script>
</body>
</html>
